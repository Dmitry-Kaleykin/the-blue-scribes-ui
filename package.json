{
	"name": "the-blue-scribes-ui",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.1.0",
	"description": "Local control panel for The Blue Scribes",
	"type": "module",
	"bin": {
		"scribes-ui": "./dist-server/server/index.js"
	},
	"files": [
		"dist",
		"dist-server",
		"README.md"
	],
	"scripts": {
		"dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
		"dev:client": "vite",
		"dev:server": "tsx watch server/index.ts --dev",
		"build": "npm run build:client && npm run build:server",
		"build:client": "vue-tsc -b && vite build",
		"build:server": "tsc --project tsconfig.server.json",
		"start": "node dist-server/server/index.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "vue-tsc -b && tsc --noEmit --project tsconfig.server.json",
		"test": "node --import tsx --test \"server/**/*.test.ts\"",
		"preview": "vite preview"
	},
	"dependencies": {
		"@fastify/static": "^10.1.2",
		"@floating-ui/vue": "^2.0.1",
		"@lucide/vue": "^1.26.0",
		"fastify": "^5.6.2",
		"open": "^10.2.0",
		"the-blue-scribes": "file:../the-blue-scribes",
		"tippy.js": "^6.3.7",
		"vue": "^3.5.39",
		"vue-tippy": "^6.7.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.13.2",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/tsconfig": "^0.9.1",
		"concurrently": "^9.2.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"tsx": "^4.21.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.1",
		"vue-tsc": "^3.3.5"
	}
}
